# Development-only image. Production and the lab keep using their small,
# compiled images; this one contains the reload tooling (Air).
FROM golang:1.26-bookworm

ARG AIR_VERSION=v1.67.3

WORKDIR /workspace

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl git make && \
    rm -rf /var/lib/apt/lists/* && \
    go install github.com/air-verse/air@${AIR_VERSION}

# Prime the dependency layer. The project source is bind-mounted by Compose.
COPY go.mod go.sum ./
RUN go mod download

ENV PATH="/go/bin:${PATH}" \
    NAGIPATH_DATA=/data \
    NAGIPATH_LISTEN=0.0.0.0:8080

EXPOSE 8080
