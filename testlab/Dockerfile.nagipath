# nagipath itself. Build context is the repository root.
#
# CGO_ENABLED=0 is not an optimisation: modernc.org/sqlite is pure Go precisely so
# that this stays one static binary with no runtime dependency to install.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags "-s -w -X main.Version=lab" -o /nagipath ./cmd/nagipath

FROM alpine:3.21
RUN apk add --no-cache ca-certificates && adduser -D -h /data nagipath
COPY --from=build /nagipath /usr/local/bin/nagipath
USER nagipath
ENV NAGIPATH_DATA=/data NAGIPATH_LISTEN=0.0.0.0:8080
EXPOSE 8080
ENTRYPOINT ["nagipath"]
CMD ["server"]
